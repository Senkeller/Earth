ns/GmeekTOC.js'></script><script src='./assets/journal-post.js'></script>","head":"","ogImage":"https://github.com/user-attachments/assets/2d046a80-cbc8-4d9e-8293-3a6e18a7d590","createdDate":"2024-07-22","dateLabelColor":"#bc4c00"},"P17":{"htmlDir":"docs/post/fen-quan-shu-zhi-gai-xing- -bi-ji.html","labels":["笔记","树脂"],"postTitle":"酚醛树脂改性 笔记","postUrl":"post/fen-quan-shu-zhi-gai-xing-%20-bi-ji.html","postSourceUrl":"https://github.com/Senkeller/Earth/issues/17","commentNum":0,"wordCount":2869,"description":"线型酚醛树脂\r\n传统酚醛树脂固化过程释放挥发分，固化后交联结构存在不足，如紧密堆砌的刚性芳环导致其脆性高，易氧化的酚羟基与亚甲基降低了\r\n其耐热性和残炭率。","top":0,"createdAt":1721819568,"style":"<link rel='stylesheet' href='./assets/journal-style.css'>","script":"<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script><script src='./assets/journal-post.js'></script>","head":"","ogImage":"https://github.com/user-attachments/assets/2d046a80-cbc8-4d9e-8293-3a6e18a7d590","createdDate":"2024-07-24","dateLabelColor":"#bc4c00"},"P18":{"htmlDir":"docs/post/da-dou-dan-bai-jiao-nian-ji---bi-ji.html","labels":["笔记","胶黏剂"],"postTitle":"大豆蛋白胶黏剂-笔记","postUrl":"post/da-dou-dan-bai-jiao-nian-ji---bi-ji.html","postSourceUrl":"https://github.com/Senkeller/Earth/issues/18","commentNum":0,"wordCount":3292,"description":"![JOE](https://github.com/user-attachments/assets/8e3980da-e615-4710-a4f3-7a5eea566394)\r\n**大豆蛋白胶黏剂存在粘度大、流动性差、耐水胶接性能达不到使用要求等缺点，不利于其在人造板工业中的大规模使用\r\n化学改性是目前改性大豆蛋白胶黏剂相对常用的方法。","top":0,"createdAt":1721824018,"style":"<link rel='stylesheet' href='./assets/journal-style.css'>","script":"<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script><script src='./assets/journal-post.js'></script>","head":"","ogImage":"https://github.com/user-attachments/assets/2d046a80-cbc8-4d9e-8293-3a6e18a7d590","createdDate":"2024-07-24","dateLabelColor":"#bc4c00"},"P19":{"htmlDir":"docs/post/ren-zao-ban-jia-quan-shi-fang-biao-zhun---bi-ji.html","labels":["笔记","人造板"],"postTitle":"人造板甲醛释放标准-笔记","postUrl":"post/ren-zao-ban-jia-quan-shi-fang-biao-zhun---bi-ji.html","postSourceUrl":"https://github.com/Senkeller/Earth/issues/19","commentNum":0,"wordCount":3353,"description":"# 强制性国家标准\r\n如《GB 18580-2017 室内装饰装修材料—人造板及其制品中甲醛释放量》是所有室内装饰装修材料在甲醛释放量方面上必须执行的国家标准。","top":0,"createdAt":1722328174,"style":"<link rel='stylesheet' href='./assets/journal-style.css'>","script":"<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script><script src='./assets/journal-post.js'></script>","head":"","ogImage":"https://github.com/user-attachments/assets/2d046a80-cbc8-4d9e-8293-3a6e18a7d590","createdDate":"2024-07-30","dateLabelColor":"#bc4c00"},"P20":{"htmlDir":"docs/post/niao-quan-shu-zhi-he-cheng-ji-pei-fang.html","labels":["笔记","树脂"],"postTitle":"脲醛树脂合成及配方","postUrl":"post/niao-quan-shu-zhi-he-cheng-ji-pei-fang.html","postSourceUrl":"https://github.com/Senkeller/Earth/issues/20","commentNum":0,"wordCount":2688,"description":"![JOE](https://github.com/user-attachments/assets/751d86df-ced6-4f49-8e37-0cfb1dc5f958)\r\n\r\n# 固化机理\r\n脲醛树脂的固化是在酸性或高温条件下，树脂分子链通过其活性基团(羟甲基及氮原子的活泼氢)继续进行缩聚反应的结果。","top":0,"createdAt":1722569479,"style":"<link rel='stylesheet' href='./assets/journal-style.css'>","script":"<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script><script src='./assets/journal-post.js'></script>","head":"","ogImage":"https://github.com/user-attachments/assets/2d046a80-cbc8-4d9e-8293-3a6e18a7d590","createdDate":"2024-08-02","dateLabelColor":"#bc4c00"},"P21":{"htmlDir":"docs/post/MUF -san-ju-qing-an-shu-zhi.html","labels":["笔记","树脂"],"postTitle":"MUF 三聚氰胺树脂","postUrl":"post/MUF%20-san-ju-qing-an-shu-zhi.html","postSourceUrl":"https://github.com/Senkeller/Earth/issues/21","commentNum":0,"wordCount":2259,"description":"# 三聚氰胺\r\n从三聚氰胺自身的结构来看，它具有一个环状结构，具有六个活性基团(通常只有三个参加反应)，这就在很大程度上促进了醛树脂的交联，形成三维网状结构。","top":0,"createdAt":1723768255,"style":"<link rel='stylesheet' href='./assets/journal-style.css'>","script":"<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script><script src='./assets/journal-post.js'></script>","head":"","ogImage":"https://github.com/user-attachments/assets/2d046a80-cbc8-4d9e-8293-3a6e18a7d590","createdDate":"2024-08-16","dateLabelColor":"#bc4c00"},"P22":{"htmlDir":"docs/post/leng-ya-yong-niao-quan-shu-zhi.html","labels":["笔记","树脂"],"postTitle":"冷压用脲醛树脂","postUrl":"post/leng-ya-yong-niao-quan-shu-zhi.html","postSourceUrl":"https://github.com/Senkeller/Earth/issues/22","commentNum":0,"wordCount":2460,"description":"冷固性脲醛树脂，要求固含量高，粘度大，活性高。","top":0,"createdAt":1724028322,"style":"<link rel='stylesheet' href='./assets/journal-style.css'>","script":"<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script><script src='./assets/journal-post.js'></script>","head":"","ogImage":"https://github.com/user-attachments/assets/2d046a80-cbc8-4d9e-8293-3a6e18a7d590","createdDate":"2024-08-19","dateLabelColor":"#bc4c00"},"P23":{"htmlDir":"docs/post/er-qiang-jia-ji-yi-xi-niao-shu-zhi.html","labels":["笔记","树脂"],"postTitle":"二羟甲基乙烯脲树脂","postUrl":"post/er-qiang-jia-ji-yi-xi-niao-shu-zhi.html","postSourceUrl":"https://github.com/Senkeller/Earth/issues/23","commentNum":0,"wordCount":1230,"description":"# 二羟甲基乙烯脲树脂\r\n无色至淡黄色液体，能与水以任意比例混溶。","top":0,"createdAt":1724047005,"style":"<link rel='stylesheet' href='./assets/journal-style.css'>","script":"<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script><script src='./assets/journal-post.js'></script>","head":"","ogImage":"https://github.com/user-attachments/assets/2d046a80-cbc8-4d9e-8293-3a6e18a7d590","createdDate":"2024-08-19","dateLabelColor":"#bc4c00"},"P24":{"htmlDir":"docs/post/ren-zao-ban-xing-ye-dong-cha.html","labels":["笔记","人造板"],"postTitle":"人造板行业洞察","postUrl":"post/ren-zao-ban-xing-ye-dong-cha.html","postSourceUrl":"https://github.com/Senkeller/Earth/issues/24","commentNum":0,"wordCount":1158,"description":"# 兔宝宝研究方向\r\n![image](https://github.com/user-attachments/assets/09559305-5984-48d8-b5ee-7626354559a9)\r\n\r\n## 板材方向\r\n\r\n- 阻燃、防腐、防水、防虫等功能性板材；\r\n- 除醛、负离子、防霉抗菌等功能性装饰板材；\r\n- 植物胶、热塑性树脂胶等非醛胶在板材上的运用；\r\n- OSB顺芯板在装饰领域的综合开发利用；\r\n- 温敏可逆变色技术在装饰材料上的运用；\r\n- 结构用胶合板、LVL的开发；环保、健康型石膏板材\r\n\r\n \r\n## 地板方向\r\n\r\n- 智能采暖地板；\r\n- 木材表面纤维融色技术\r\n\r\n## 胶粘剂方向\r\n\r\n- 环保性能方面：人造板甲醛释放量从E2级，到E1级，到E0级，到目前的无醛级，逐步升级，始终领先市场一步。","top":0,"createdAt":1724219005,"style":"<link rel='stylesheet' href='./assets/journal-style.css'>","script":"<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script><script src='./assets/journal-post.js'></script>","head":"","ogImage":"https://github.com/user-attachments/assets/2d046a80-cbc8-4d9e-8293-3a6e18a7d590","createdDate":"2024-08-21","dateLabelColor":"#bc4c00"},"P25":{"htmlDir":"docs/post/gao-fen-zi-cai-liao-de-ran-shao-he-zu-ran-ji-li.html","labels":["笔记","阻燃"],"postTitle":"高分子材料的燃烧和阻燃机理","postUrl":"post/gao-fen-zi-cai-liao-de-ran-shao-he-zu-ran-ji-li.html","postSourceUrl":"https://github.com/Senkeller/Earth/issues/25","commentNum":0,"wordCount":1768,"description":"高分子的燃烧过程十分复杂，属于激烈的热氧化过程（如下图所示)。","top":0,"createdAt":1725180489,"style":"<link rel='stylesheet' href='./assets/journal-style.css'>","script":"<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script><script src='./assets/journal-post.js'></script>","head":"","ogImage":"https://github.com/user-attachments/assets/2d046a80-cbc8-4d9e-8293-3a6e18a7d590","createdDate":"2024-09-01","dateLabelColor":"#bc4c00"},"P26":{"htmlDir":"docs/post/jin-zi-jiao-mo-zhi.html","labels":["笔记","胶黏剂"],"postTitle":"浸渍胶膜纸","postUrl":"post/jin-zi-jiao-mo-zhi.html","postSourceUrl":"https://github.com/Senkeller/Earth/issues/26","commentNum":0,"wordCount":3531,"description":"# 板材推荐\r\n\r\n高端推荐：木饰面；科技木皮\r\n\r\n中端推荐：PET饰面；\r\n\r\n大众推荐：三聚氰胺饰面；\r\n\r\n造型推荐：PVC饰面。","top":0,"createdAt":1725672713,"style":"<link rel='stylesheet' href='./assets/journal-style.css'>","script":"<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script><script src='./assets/journal-post.js'></script>","head":"","ogImage":"https://gi